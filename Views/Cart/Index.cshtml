@model List<MVC031.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2>Giỏ hàng</h2>

@if (!Model.Any())
{
    <p>Giỏ hàng đang trống. <a asp-controller="Product" asp-action="ProductList">Tiếp tục mua hàng</a></p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.ImageURL" alt="@item.ProductName"
                             style="width:50px; height:50px; object-fit:cover;"
                             onerror="this.src='https://via.placeholder.com/50'" />
                        @item.ProductName
                    </td>
                    <td class="text-end">@item.ProductPrice.ToString("N0") đ</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.Total.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tổng cộng</th>
                <th class="text-end">@Model.Sum(i => i.Total).ToString("N0") đ</th>
            </tr>
        </tfoot>
    </table>
    <a asp-controller="Product" asp-action="ProductList" class="btn btn-secondary">Tiếp tục mua hàng</a>
}
